# ===========================================
# SentinelAI — Environment Variables Example
# ===========================================
# Copy this to .env and fill in real values.
# NEVER commit .env to version control.

# --- Application ---
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# --- JWT Authentication ---
# Generate with: openssl rand -hex 64
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# --- PostgreSQL ---
# Local: postgresql://USER:PASSWORD@localhost:5432/sentinelai
# Neon:  postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/sentinelai?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sentinelai

# --- Redis ---
# Local: redis://localhost:6379
# Upstash: rediss://default:token@hostname.upstash.io:6379
REDIS_URL=redis://localhost:6379

# --- Groq LLM ---
# Get your key at: https://console.groq.com
# Model list: https://console.groq.com/docs/models
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# --- GitHub ---
# Create at: https://github.com/settings/tokens (classic token or fine-grained)
# Scopes needed: repo (read), public_repo
# For public repos only, this is optional but prevents rate limiting
GITHUB_TOKEN=ghp_your_github_token_here

# --- Workspaces ---
# Directory where repositories are cloned for analysis (created automatically)
WORKSPACE_DIR=/tmp/sentinel-workspaces

# --- Agent Limits ---
AGENT_MAX_ITERATIONS=20
AGENT_MAX_TOOL_CALLS=50
AGENT_TIMEOUT_SECONDS=300

# --- Load Testing Limits ---
# Maximum k6 VUs (virtual users) allowed
K6_MAX_VUS=100
# Maximum test duration in seconds
K6_MAX_DURATION_SECONDS=60
# Whether to require human approval before load tests (true/false)
REQUIRE_LOAD_TEST_APPROVAL=true

# --- Embeddings ---
# We use Groq for embeddings via a compatible model or local embeddings
# If using OpenAI embeddings, add key here (optional, Groq used by default)
# OPENAI_API_KEY=sk-...
